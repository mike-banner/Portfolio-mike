---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import ecommerceImg from '../assets/images/project-ecommerce.png';
import vtcImg from '../assets/images/project-vtc.png';
import vtchubImg from '../assets/images/project-vtchub.png';
import briquerougeImg from '../assets/images/project-briquerouge.png';
import langueturquoiseImg from '../assets/images/project-langueturquoise.png';
---

<Layout
  title="Accueil"
  description="Portfolio professionnel de Mike, architecte cloud-edge & automatisation IA. Découvrez mes architectures serverless et systèmes d'agents autonomes."
>

  <!-- ═══════════════════════════════════════
       NAVIGATION
  ═══════════════════════════════════════ -->
  <header class="header" role="banner">
    <nav class="nav" aria-label="Navigation principale">
      <a href="#" class="logo" aria-label="Retour en haut">M<span class="dot">.</span></a>

      <ul class="nav-links" role="list">
        <li><a href="#">Accueil</a></li>
        <li><a href="#projects">Projets</a></li>
        <li><a href="#skills">Compétences</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>

      <button class="hamburger" id="menuBtn" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobileDrawer">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </header>

  <!-- Mobile drawer -->
  <div class="drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Menu de navigation" hidden>
    <div class="drawer-overlay" id="drawerOverlay"></div>
    <nav class="drawer-nav">
      <button class="drawer-close" id="drawerClose" aria-label="Fermer le menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <ul role="list">
        <li><a href="#" class="drawer-link">Accueil</a></li>
        <li><a href="#projects" class="drawer-link">Projets</a></li>
        <li><a href="#skills" class="drawer-link">Compétences</a></li>
        <li><a href="#contact" class="drawer-link">Contact</a></li>
      </ul>
    </nav>
  </div>

  <!-- ═══════════════════════════════════════
       HERO
  ═══════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-inner">

      <div class="hero-content">
        <div class="badge" role="status">
          <span class="badge-dot" aria-hidden="true"></span>
          Disponible pour opportunités
        </div>

        <h1 id="hero-heading">
          <span class="hero-name">Mike</span>
          <span class="hero-title">Architecte <span class="hero-accent">Cloud-Edge</span><br>&amp; Automatisation IA</span>
        </h1>

        <p class="hero-desc">
          Je conçois des architectures cloud serverless ultra-performantes, des systèmes multi-tenant scalables et des pipelines d'automatisation avec agents IA pour maximiser l'efficacité opérationnelle des entreprises.
        </p>

        <div class="hero-tags" aria-label="Technologies maîtrisées">
          <span class="tag">n8n / Agents IA</span>
          <span class="tag">Cloudflare Workers</span>
          <span class="tag">Supabase / RAG</span>
          <span class="tag">Astro / React</span>
          <span class="tag">VPS &amp; Docker / Coolify</span>
        </div>

        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">Voir mes projets</a>
          <a href="#contact" class="btn btn-secondary">Me contacter</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="code-window">
          <div class="window-bar">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
            <span class="window-title">agent.ts</span>
          </div>
          <pre class="code-block"><code set:html={[
            '<span class="kw">const</span> <span class="fn">architect</span> <span class="op">=</span> <span class="kw">new</span> <span class="fn">AIAgent</span>({',
            '\n  <span class="key">role</span><span class="op">:</span> <span class="str">"Edge &amp; Automation Architect"</span>,',
            '\n  <span class="key">stack</span><span class="op">:</span> &#91;',
            '\n    <span class="str">"n8n"</span>, <span class="str">"Cloudflare Edge"</span>,',
            '\n    <span class="str">"Supabase / Vector DB"</span>,',
            '\n  &#93;,',
            '\n  <span class="key">mission</span><span class="op">:</span> <span class="str">"Maximize ROI &amp; Auto-scale operations"</span>,',
            '\n  <span class="key">ready</span><span class="op">:</span> <span class="bool">true</span>,',
            '\n})<span class="op">;</span>',
            '\n\n<span class="kw">export default</span> architect<span class="op">;</span>',
          ].join('')}></code></pre>
        </div>

      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════
       PROJECTS
  ═══════════════════════════════════════ -->
  <section id="projects" class="section" aria-labelledby="projects-heading">
    <div class="section-header">
      <h2 id="projects-heading" class="section-title">Projets</h2>
    </div>

    <div class="project-filters" role="group" aria-label="Filtrer les projets par technologie">
      <button class="filter-btn active" data-filter="modern">Astro / React</button>
      <button class="filter-btn" data-filter="wordpress">WordPress</button>
      <button class="filter-btn" data-filter="devops">DevOps &amp; Edge</button>
    </div>

    <div class="bento-grid">

      <!-- Project 1 — large -->
      <article class="project-card card-large" data-tech="react devops">
        <div class="card-image">
          <Image
            src={vtcImg}
            alt="Interface mobile de la plateforme SaaS VTC"
            width={800}
            height={500}
            format="avif"
            fetchpriority="high"
            class="proj-img"
          />
          <div class="card-overlay">
            <span class="overlay-category">React / TypeScript / Cloudflare</span>
          </div>
        </div>
        <div class="card-body">
          <h3>Plateforme SaaS VTC</h3>
          <p>Moteur de réservation B2B complexe avec estimation des tarifs à la volée, géolocalisation Cloudflare Workers et caching KV.</p>
          <ul class="tech-pills" aria-label="Technologies utilisées">
            <li>React</li><li>TypeScript</li><li>CF Workers</li><li>Tailwind</li>
          </ul>
        </div>
      </article>

      <!-- Project 2 — large -->
      <article class="project-card card-large" data-tech="astro devops">
        <div class="card-image">
          <Image
            src={vtchubImg}
            alt="Interface mobile de VTC HUB"
            width={800}
            height={500}
            format="avif"
            class="proj-img"
          />
          <div class="card-overlay">
            <span class="overlay-category">Astro 5 / Supabase / Stripe</span>
          </div>
        </div>
        <div class="card-body">
          <h3>VTC HUB — Multi-Tenant</h3>
          <p>Plateforme "Shopify-like" pour services VTC. Résolution Host-Header, isolation multi-tenant (RLS) et tunnel Stripe Checkout.</p>
          <ul class="tech-pills" aria-label="Technologies utilisées">
            <li>Astro 5</li><li>Supabase</li><li>Stripe</li><li>Tailwind v4</li>
          </ul>
        </div>
      </article>

      <!-- Project 3 — small -->
      <article class="project-card card-small" data-tech="astro wordpress">
        <div class="card-image card-image--short">
          <Image
            src={ecommerceImg}
            alt="Mockup du site e-commerce Meliponini"
            width={600}
            height={340}
            format="avif"
            class="proj-img"
          />
          <div class="card-overlay">
            <span class="overlay-category">Astro + WP Headless</span>
          </div>
        </div>
        <div class="card-body">
          <h3>Meliponini E-Commerce</h3>
          <p>Boutique headless ultra-rapide, catalogue synchronisé via GraphQL avec WooCommerce.</p>
          <ul class="tech-pills" aria-label="Technologies utilisées">
            <li>Astro</li><li>GraphQL</li><li>WooCommerce</li>
          </ul>
        </div>
      </article>

      <!-- Project 4 — small -->
      <article class="project-card card-small" data-tech="wordpress">
        <div class="card-image card-image--short">
          <Image
            src={briquerougeImg}
            alt="Mockup du site Studio La Brique Rouge"
            width={600}
            height={340}
            format="avif"
            class="proj-img"
          />
          <div class="card-overlay">
            <span class="overlay-category">Site Média &amp; Réservation</span>
          </div>
        </div>
        <div class="card-body">
          <h3>Studio La Brique Rouge</h3>
          <p>Optimisation extrême des performances (Core Web Vitals) pour l'affichage de portfolios photo/vidéo HD et tunnel de demande de devis.</p>
          <ul class="tech-pills" aria-label="Technologies utilisées">
            <li>WordPress</li><li>Vanilla JS</li><li>WebPerf</li>
          </ul>
        </div>
      </article>

      <!-- Project 5 — wide -->
      <article class="project-card card-wide" data-tech="wordpress">
        <div class="card-image card-image--short">
          <Image
            src={langueturquoiseImg}
            alt="Mockup du site Langue Turquoise"
            width={600}
            height={340}
            format="avif"
            class="proj-img"
          />
          <div class="card-overlay">
            <span class="overlay-category">Accessibilité WCAG / RGAA</span>
          </div>
        </div>
        <div class="card-body">
          <h3>Langue Turquoise</h3>
          <p>Conception d'un portail inclusif avec intégration vidéo LSF, conformité rigoureuse aux normes d'accessibilité numérique (RGAA).</p>
          <ul class="tech-pills" aria-label="Technologies utilisées">
            <li>WordPress</li><li>a11y</li><li>HTML5 Semantics</li>
          </ul>
        </div>
      </article>

    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SKILLS
  ═══════════════════════════════════════ -->
  <section id="skills" class="section section--alt" aria-labelledby="skills-heading">
    <div class="section-header">
      <h2 id="skills-heading" class="section-title">Compétences</h2>
    </div>

    <div class="skills-grid">

      <div class="skill-card">
        <div class="skill-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
        </div>
        <h3>Cloud & Serverless Edge</h3>
        <ul>
          <li>Cloudflare Workers / KV / R2</li>
          <li>Supabase (DB, RLS, Edge Functions)</li>
          <li>Déploiement VPS (Hetzner, Docker, Coolify)</li>
          <li>Architectures API (REST, GraphQL)</li>
        </ul>
      </div>

      <div class="skill-card">
        <div class="skill-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <h3>Automatisation & IA</h3>
        <ul>
          <li>n8n & Pipelines complexes</li>
          <li>Intégrations LLMs (OpenAI, Anthropic)</li>
          <li>Agents Autonomes & Vector DBs</li>
          <li>Scripts de synchronisation sur-mesure</li>
        </ul>
      </div>

      <div class="skill-card">
        <div class="skill-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </div>
        <h3>Architectures Web Modernes</h3>
        <ul>
          <li>React / Astro / TypeScript</li>
          <li>CMS Headless & WordPress découpé</li>
          <li>WebPerf & Core Web Vitals (Score 100)</li>
          <li>Sécurisation des transactions (Stripe API)</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════
       CONTACT
  ═══════════════════════════════════════ -->
  <section id="contact" class="section" aria-labelledby="contact-heading">
    <div class="section-header">
      <h2 id="contact-heading" class="section-title">Contact</h2>
    </div>

    <div class="contact-wrap">
      <form class="contact-form" id="contactForm" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Nom</label>
            <input type="text" id="name" name="name" required placeholder="Votre nom" autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" required placeholder="votre@email.com" autocomplete="email" />
          </div>
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required placeholder="Votre message..."></textarea>
        </div>

        <div id="formStatus" class="form-status" role="alert" aria-live="polite" hidden></div>

        <button type="submit" class="btn btn-primary btn-submit" id="submitBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Envoyer le message
        </button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer" role="contentinfo">
    <p>&copy; {new Date().getFullYear()} Mike. Tous droits réservés.</p>
    <p class="footer-sub">Construit avec <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> &amp; déployé sur Cloudflare Pages.</p>
  </footer>

</Layout>

<!-- ═══════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════ -->
<script>
  /* ── Project Filtering ── */
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectCards  = document.querySelectorAll('.project-card');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      const filter = button.getAttribute('data-filter') || 'modern';

      projectCards.forEach(card => {
        const techAttr = card.getAttribute('data-tech') || '';
        const techs = techAttr.split(' ');
        
        let isVisible = false;
        if (filter === 'modern') {
          isVisible = techs.includes('astro') || techs.includes('react');
        } else {
          isVisible = techs.includes(filter);
        }

        if (isVisible) {
          card.classList.remove('filtered-out');
        } else {
          card.classList.add('filtered-out');
        }
      });
    });
  });

  // Déclencher le filtre par défaut au chargement
  const defaultActive = document.querySelector('.filter-btn.active') as HTMLButtonElement | null;
  if (defaultActive) {
    defaultActive.click();
  }

  /* ── Mobile menu ── */
  const menuBtn = document.getElementById('menuBtn') as HTMLButtonElement | null;
  const drawer  = document.getElementById('mobileDrawer') as HTMLElement | null;
  const overlay = document.getElementById('drawerOverlay');
  const closeBtn = document.getElementById('drawerClose');
  const drawerLinks = document.querySelectorAll('.drawer-link');

  function openDrawer() {
    if (!drawer || !menuBtn) return;
    drawer.hidden = false;
    menuBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    if (!drawer || !menuBtn) return;
    drawer.hidden = true;
    menuBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  drawerLinks.forEach(l => l.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

  /* ── Contact form ── */
  const form      = document.getElementById('contactForm') as HTMLFormElement | null;
  const statusDiv = document.getElementById('formStatus') as HTMLElement | null;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours…';

      if (statusDiv) {
        statusDiv.hidden = false;
        statusDiv.className = 'form-status info';
        statusDiv.textContent = 'Envoi de votre message…';
      }

      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok || response.status === 404) {
          if (statusDiv) {
            statusDiv.className = 'form-status success';
            statusDiv.textContent = 'Message envoyé ! Merci, je vous répondrai rapidement.';
          }
          form.reset();
        } else {
          throw new Error('Erreur de transmission');
        }
      } catch {
        if (statusDiv) {
          statusDiv.className = 'form-status error';
          statusDiv.textContent = "Une erreur est survenue. Veuillez réessayer ou m'écrire directement.";
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Envoyer le message`;
      }
    });
  }
</script>

<!-- ═══════════════════════════════════════
     STYLES
═══════════════════════════════════════ -->
<style>
  /* ─── Layout helpers ─────────────────── */
  .section {
    padding: 5rem 1.25rem;
    width: 100%;
    border-bottom: 1px solid var(--border);
  }
  .section--alt {
    background-color: var(--bg-surface);
  }

  /* ─── Nav ────────────────────────────── */
  .header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: var(--z-nav);
    background: rgba(3, 7, 18, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.03em;
  }
  .logo .dot { color: var(--accent); }

  .nav-links {
    display: none;
    list-style: none;
    gap: 2rem;
  }
  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--text-primary); }

  /* Hamburger */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    padding: 0 10px;
    transition: border-color 0.2s;
  }
  .hamburger:hover { border-color: var(--border-hover); }
  .hamburger span {
    display: block;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
  }

  /* Mobile Drawer */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
  }
  .drawer-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  .drawer-nav {
    position: absolute;
    top: 0; right: 0;
    width: min(320px, 85vw);
    height: 100%;
    background: var(--bg-elevated);
    border-left: 1px solid var(--border);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .drawer-close {
    align-self: flex-end;
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.4rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .drawer-close:hover { color: var(--text-primary); border-color: var(--border-hover); }
  .drawer-nav ul { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }
  .drawer-link {
    display: block;
    padding: 0.85rem 1rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
    border-radius: 10px;
    transition: background 0.2s, color 0.2s;
  }
  .drawer-link:hover {
    background: rgba(99, 102, 241, 0.1);
    color: var(--text-primary);
  }

  /* ─── Buttons ────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.75rem;
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    border: 1px solid transparent;
  }
  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .btn-primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 4px 16px var(--accent-glow);
  }
  .btn-primary:hover:not(:disabled) {
    background: var(--accent-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--accent-glow);
  }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
  .btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border-color: var(--border);
  }
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  /* ─── Hero ───────────────────────────── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 6rem 1.25rem 4rem;
    background:
      radial-gradient(ellipse 60% 50% at 80% 20%, rgba(99, 102, 241, 0.12), transparent),
      radial-gradient(ellipse 50% 40% at 10% 80%, rgba(34, 211, 238, 0.07), transparent);
  }
  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

