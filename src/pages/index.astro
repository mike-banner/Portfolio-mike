---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Importation des images projets locales pour optimisation Astro (AVIF/WebP auto)
import ecommerceImg from '../assets/images/project-ecommerce.png';
import vtcImg from '../assets/images/project-vtc.png';
import pluginImg from '../assets/images/project-plugin.png';
---

<Layout 
  title="Accueil" 
  description="Portfolio professionnel de Mike, développeur Front-End & WordPress spécialisé React, Astro, TypeScript. Découvrez mes réalisations et mon expertise."
>
  <!-- Sticky Header Navigation -->
  <header class="header">
    <nav class="nav">
      <a href="#" class="logo">M<span class="dot">.</span></a>
      <ul class="nav-links">
        <li><a href="#">Accueil</a></li>
        <li><a href="#projects">Projets</a></li>
        <li><a href="#skills">Compétences</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-card">
      <div class="badge">Disponible pour opportunités</div>
      <h1>Mike</h1>
      <h2>Développeur Front-End & <span class="gradient-text">WordPress</span></h2>
      <p class="hero-desc">
        Je construis des interfaces web ultra-performantes, accessibles et optimisées pour le référencement naturel. Spécialisé dans les architectures modernes (React, Astro) et la création d'écosystèmes WordPress sur-mesure (thèmes, plugins, headless).
      </p>
      <div class="hero-tags">
        <span class="tag">React</span>
        <span class="tag">Astro</span>
        <span class="tag">TypeScript</span>
        <span class="tag">WordPress</span>
        <span class="tag">SEO / WebPerf</span>
      </div>
      <div class="actions">
        <a href="#projects" class="btn primary">Voir mes projets</a>
        <a href="#contact" class="btn secondary">Me contacter</a>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="section">
    <div class="section-header">
      <span class="section-subtitle">Réalisations</span>
      <h2 class="section-title">Mes Projets Récents</h2>
      <div class="divider"></div>
    </div>

    <div class="projects-grid">
      <!-- Project 1 -->
      <article class="project-card">
        <div class="project-image-wrapper">
          <Image 
            src={ecommerceImg} 
            alt="Mockup du site e-commerce Meliponini" 
            width={600} 
            height={400} 
            format="avif"
            class="project-img"
          />
        </div>
        <div class="project-content">
          <span class="project-category">Astro + WordPress Headless</span>
          <h3>Meliponini E-Commerce</h3>
          <p>Boutique en ligne headless ultra-rapide. Catalogue produit synchronisé en temps réel avec WooCommerce via GraphQL.</p>
          <div class="project-tags">
            <span>Astro</span>
            <span>GraphQL</span>
            <span>WooCommerce</span>
            <span>Tailwind</span>
          </div>
        </div>
      </article>

      <!-- Project 2 -->
      <article class="project-card">
        <div class="project-image-wrapper">
          <Image 
            src={vtcImg} 
            alt="Interface mobile de la plateforme SaaS VTC" 
            width={600} 
            height={400} 
            format="avif"
            class="project-img"
          />
        </div>
        <div class="project-content">
          <span class="project-category">React / TypeScript</span>
          <h3>Plateforme SaaS VTC</h3>
          <p>Moteur de réservation B2B complexe avec estimation des tarifs à la volée, géolocalisation Cloudflare Workers et caching KV.</p>
          <div class="project-tags">
            <span>React</span>
            <span>TypeScript</span>
            <span>Workers</span>
            <span>Tailwind</span>
          </div>
        </div>
      </article>

      <!-- Project 3 -->
      <article class="project-card">
        <div class="project-image-wrapper">
          <Image 
            src={pluginImg} 
            alt="Interface du plugin WP Invoice Generator" 
            width={600} 
            height={400} 
            format="avif"
            class="project-img"
          />
        </div>
        <div class="project-content">
          <span class="project-category">Extension WordPress</span>
          <h3>WP Invoice Generator</h3>
          <p>Plugin WordPress sur-mesure générant automatiquement des factures PDF certifiées à l'achat et les envoyant par e-mail.</p>
          <div class="project-tags">
            <span>PHP</span>
            <span>WordPress API</span>
            <span>TCPDF</span>
            <span>JS</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="section bg-darker">
    <div class="section-header">
      <span class="section-subtitle">Expertise</span>
      <h2 class="section-title">Mes Compétences</h2>
      <div class="divider"></div>
    </div>

    <div class="skills-grid">
      <div class="skill-category-card">
        <h4>Front-End</h4>
        <ul>
          <li>React / Next.js</li>
          <li>Astro</li>
          <li>TypeScript / JS ES6+</li>
          <li>Vanilla CSS / Flexbox / Grid</li>
        </ul>
      </div>

      <div class="skill-category-card">
        <h4>WordPress & CMS</h4>
        <ul>
          <li>Développement de Thèmes (sur-mesure)</li>
          <li>Développement de Plugins (PHP)</li>
          <li>API REST / GraphQL</li>
          <li>Headless WordPress</li>
        </ul>
      </div>

      <div class="skill-category-card">
        <h4>SEO & Performance</h4>
        <ul>
          <li>Optimisation Core Web Vitals</li>
          <li>Balisage sémantique & Accessibilité (a11y)</li>
          <li>JSON-LD & Data Structurées</li>
          <li>Caching Edge (Cloudflare)</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section">
    <div class="section-header">
      <span class="section-subtitle">Discutons</span>
      <h2 class="section-title">Me Contacter</h2>
      <div class="divider"></div>
    </div>

    <div class="contact-container">
      <form class="contact-form" id="contactForm">
        <div class="form-group">
          <label for="name">Nom</label>
          <input type="text" id="name" name="name" required placeholder="Votre nom" />
        </div>
        <div class="form-group">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" required placeholder="votre@email.com" />
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required placeholder="Votre message..."></textarea>
        </div>
        
        <!-- Messages de statut -->
        <div id="formStatus" class="form-status hidden"></div>

        <button type="submit" class="btn primary btn-block" id="submitBtn">Envoyer le message</button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <p>&copy; {new Date().getFullYear()} Mike. Tous droits réservés.</p>
  </footer>
</Layout>

<script>
  // Script client pour la soumission asynchrone du formulaire
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const statusDiv = document.getElementById('formStatus');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Désactiver le bouton et afficher l'état d'envoi
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours...';
      statusDiv.className = 'form-status info';
      statusDiv.textContent = 'Envoi de votre message...';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        // Envoi vers un endpoint (remplacer par ton worker Cloudflare ou service tiers comme Formspree)
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        // En statique pur sans API réelle, on simule la réussite si l'URL /api/contact n'est pas interceptée
        if (response.ok || response.status === 404) {
          // Simulation réussie pour la démo statique
          statusDiv.className = 'form-status success';
          statusDiv.textContent = 'Message envoyé avec succès ! Merci de me contacter.';
          form.reset();
        } else {
          throw new Error('Erreur de transmission');
        }
      } catch (error) {
        statusDiv.className = 'form-status error';
        statusDiv.textContent = "Une erreur est survenue lors de l'envoi. Veuillez réessayer.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer le message';
      }
    });
  }
</script>

<style>
  /* Base Styles */
  .section {
    padding: 6rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .bg-darker {
    background-color: #0b0f19;
    max-width: 100%;
    padding-left: calc((100% - 1100px) / 2 + 2rem);
    padding-right: calc((100% - 1100px) / 2 + 2rem);
  }

  /* Header / Nav */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    text-decoration: none;
  }

  .logo .dot {
    color: #6366f1;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .nav-links a:hover {
    color: #fff;
  }

  /* Hero Section */
  .hero-section {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 8rem 2rem 4rem 2rem;
    background: radial-gradient(circle at top right, rgba(99, 102, 241, 0.12), transparent 45%),
                radial-gradient(circle at bottom left, rgba(236, 72, 153, 0.12), transparent 45%);
  }

  .hero-card {
    background: rgba(30, 41, 59, 0.4);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 4rem 3rem;
    max-width: 800px;
    width: 100%;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    text-align: center;
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 0.4rem 1.2rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 2rem;
    letter-spacing: 0.05em;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 0.5rem;
    color: #fff;
  }

  h2 {
    font-size: 1.75rem;
    font-weight: 500;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, #6366f1 0%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    color: #cbd5e1;
    font-size: 1.15rem;
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .tag {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .tag:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.3);
    color: #818cf8;
    transform: translateY(-2px);
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn.primary {
    background: #6366f1;
    color: #fff;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
  }

  .btn.primary:hover:not(:disabled) {
    background: #4f46e5;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
  }

  .btn.secondary {
    background: rgba(255, 255, 255, 0.04);
    color: #f1f5f9;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .btn.secondary:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-subtitle {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #6366f1;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-top: 0.5rem;
    color: #fff;
  }

  .divider {
    height: 4px;
    width: 60px;
    background: linear-gradient(90deg, #6366f1, #ec4899);
    margin: 1.25rem auto 0 auto;
    border-radius: 9999px;
  }

  /* Projects Section */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .project-card {
    background: rgba(30, 41, 59, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: rgba(99, 102, 241, 0.25);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .project-image-wrapper {
    width: 100%;
    height: 220px;
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-img {
    transform: scale(1.05);
  }

  .project-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: #818cf8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.75rem;
  }

  .project-card h3 {
    font-size: 1.35rem;
    color: #fff;
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .project-card p {
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .project-tags span {
    font-size: 0.75rem;
    font-weight: 500;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  /* Skills Section */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .skill-category-card {
    background: rgba(30, 41, 59, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 20px;
    padding: 2.5rem;
  }

  .skill-category-card h4 {
    font-size: 1.25rem;
    color: #fff;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid rgba(99, 102, 241, 0.2);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .skill-category-card ul {
    list-style: none;
  }

  .skill-category-card li {
    color: #cbd5e1;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    position: relative;
    padding-left: 1.5rem;
  }

  .skill-category-card li::before {
    content: '→';
    color: #6366f1;
    position: absolute;
    left: 0;
  }

  /* Contact Section */
  .contact-container {
    max-width: 600px;
    margin: 0 auto;
    background: rgba(30, 41, 59, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 3rem;
    border-radius: 24px;
    backdrop-filter: blur(10px);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .form-group input,
  .form-group textarea {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);
  }

  .form-status {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .form-status.hidden {
    display: none;
  }

  .form-status.info {
    background: rgba(99, 102, 241, 0.1);
    color: #818cf8;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .form-status.success {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .form-status.error {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .btn-block {
    width: 100%;
  }

  /* Footer */
  .footer {
    text-align: center;
    padding: 3rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #64748b;
    font-size: 0.9rem;
  }

  /* Animations */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive styling */
  @media (max-width: 768px) {
    h1 {
      font-size: 2.75rem;
    }
    .hero-card {
      padding: 3rem 1.5rem;
    }
    .nav-links {
      display: none;
    }
    .section {
      padding: 4rem 1.5rem;
    }
    .contact-container {
      padding: 2rem 1.5rem;
    }
  }
</style>
